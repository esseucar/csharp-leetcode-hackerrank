public class Solution {
    public bool IsPalindrome(int x) {
        string num = x.ToString();
        int len= num.Length;
        bool result=true;
        for(int i=0; i<len/2;i++){
            if(num[i]==num[len-i-1])
            {
               result=true;
               continue; 
            }
            else
            {
                result=false;
                break; 
            }
        }return result;
    }
}
