public class Solution {
    public string LongestCommonPrefix(string[] strs) {
        int MinLength=strs.Min(s=>s.Length);
        string result="";
        for(int i=0;i<MinLength;i++){
            char current=strs[0][i];
            for(int j=1;j<strs.Length;j++)
            {
                if(strs[j][i]!=current){
                    return result;
                }
            }                                          
             result+=current;
            
        }  
            return result;
    }
}
